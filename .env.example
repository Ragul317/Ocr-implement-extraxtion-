# Copy to .env and adjust. Never commit .env.

# --- LLM (DSPy via LiteLLM) ---
LLM_MODEL=ollama_chat/qwen2.5:3b
LLM_API_BASE=http://localhost:11434
# Empty for Ollama; set only if you later switch to a hosted provider.
LLM_API_KEY=
# Phase 3: 10 fields took 87 s on CPU, so allow 180 s. Never retry a timeout.
LLM_TIMEOUT_SECONDS=180
LLM_NUM_RETRIES=0
# DSPy on-disk cache: the same text + same fields returns instantly.
LLM_CACHE=true

# --- OCR ---
OCR_LANG=en
OCR_DEVICE=cpu
# Chosen in Phase 2 (see EVALUATION.md). Alternative: PP-OCRv6_medium_det / PP-OCRv6_medium_rec (more accurate, ~3-4x slower, ~2x RAM)
OCR_DET_MODEL=PP-OCRv6_small_det
OCR_REC_MODEL=PP-OCRv6_small_rec
OCR_MIN_CONFIDENCE=0.5
# Downscale images whose longest side exceeds this before OCR (Phase 2: large images exhausted RAM).
OCR_MAX_SIDE=2000

# --- Upload / request limits ---
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=40000000
# End-to-end target for one request (OCR + LLM); used by the API/frontend from Phase 5.
REQUEST_TIMEOUT_SECONDS=210

# --- Field selection ---
# Safety cap only; all predefined fields can always be selected.
MAX_FIELDS=20

# --- HTTP API ---
# Browser origins allowed to call the API (comma-separated). The page served by FastAPI
# itself is same-origin; add e.g. http://localhost:5500 for a separate dev server.
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Load PaddleOCR at server startup (first request is then fast).
OCR_PRELOAD=true

# --- Misc ---
SAVE_OUTPUTS=false
LOG_LEVEL=INFO
